# Server-side secrets — never commit real keys.
# Agent: copy via app_agnostic/scripts/seed-dev-env.sh
# Human: set LLM_API_KEY to your OpenAI API key before manual or live AI features.

BACKEND_PORT=8900

# Server-side LLM (default for kit apps — keys stay off the frontend)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: Gemini thumbnails when RSS has no image
GEMINI_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-lite-image
