# =============================================================================
# Copy to .env (gitignored). Values only — never commit .env.
#
# Hermes Desktop: keys below marked [hermes-sync] are copied to ~/.hermes/.env
# by ./scripts/brain/apply-stack-config.sh (see config/brain-stack.yaml
# hermes.sync_env_keys). Model/provider come from brain-stack hermes.chat_* .
#
# LLM Wiki ingest/chat keys live in the LLM Wiki app (app-state.json), not here.
# =============================================================================

# [hermes-sync] Required for Gemini in Hermes Desktop
GEMINI_API_KEY=

# [hermes-sync] Optional OpenAI if you switch provider in brain-stack.yaml
OPENAI_API_KEY=

# [hermes-sync] Filled by sync-llm-wiki-token.sh from LLM Wiki app (or paste once)
LLM_WIKI_API_TOKEN=

# [hermes-sync] Optional alternates
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# --- Not synced to Hermes (repo scripts / LLM Wiki curl only) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
GEMINI_MODEL=
IMAGE_MODEL=
# Retail ticket search + embed_service_queries.py (Gemini; required for Phase 6 PG load)
EMBEDDING_MODEL=gemini-embedding-2
# AU = en-AU copy + Postgres english FTS; BR = pt-BR + portuguese FTS (seed, embed, eval, hybrid)
RETAIL_MARKET=AU
# Simulated ticket corpus for Postgres load + A/B: rrf_data_llm_gen (tmp/simulated_data) | rrf_data_prag_gen (seed/generated)
RETAIL_SIM_DATA_PROFILE=rrf_data_llm_gen
# Substrings removed from embed/FTS prep (| separated); SAM-E codes are kept
RETAIL_EMBED_STRIP_PHRASES=Case ref ITM-
# Keyword leg: tantivy (default) | bm25x | parade_db | open_search. Not Postgres full-text search.
RETAIL_LEXICAL_BACKEND=tantivy
# Optional directory for Tantivy and bm25x index files. Default tmp/retail_lexical/
# RETAIL_LEXICAL_INDEX_PATH=
# ParadeDB is a separate server (not the retail database on 5433).
# RETAIL_PARADEDB_URL=postgresql://retail:retail@127.0.0.1:5434/retail
# OpenSearch single-node dev URL. Default verify does not start this service.
# RETAIL_OPENSEARCH_URL=http://127.0.0.1:9200
# FRU Postgres (docker compose service retail_pg, host port 5433). Required for --postgres CLI and live E2E.
RETAIL_DATABASE_URL=postgresql://retail:retail@127.0.0.1:5433/retail
# Simulated corpus profile for load scripts and default answer_ticket CSV paths (fru_us_1k | …).
# RETAIL_SIM_DATA_PROFILE=fru_us_1k
OPENAI_BASE_URL=
OPENAI_MODEL=

# LLM_WIKI_API_BASE_URL=http://127.0.0.1:19828/api/v1

# --- [hermes-sync] Messaging (optional — Telegram / WhatsApp gateway) ---
# See docs_manual_gen/SECOND_BRAIN_RUNBOOK.md §16 and Hermes messaging docs.
# TELEGRAM_BOT_TOKEN=          # @BotFather, or Desktop/dashboard "Create with QR"
# TELEGRAM_ALLOWED_USERS=      # Numeric Telegram user id (comma-separated)
# TELEGRAM_HOME_CHANNEL=        # Same id after /sethome in DM (optional; merge script writes home_channel)
# TELEGRAM_HOME_CHANNEL_THREAD_ID=
# WHATSAPP_ENABLED=true
# WHATSAPP_MODE=bot             # bot | self-chat
# WHATSAPP_ALLOWED_USERS=       # E.164 without + (comma-separated), or * for allow-all
# WHATSAPP_HOME_CHANNEL=        # e.g. 167238074122364@lid after pairing
# WHATSAPP_HOME_USER_ID=        # e.g. 5519982287057@s.whatsapp.net (optional in config merge)
# WHATSAPP_HOME_CHANNEL_THREAD_ID=
