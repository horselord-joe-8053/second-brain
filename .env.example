# =============================================================================
# Local overlay (copy to .env). Values only — never commit .env.
# Nashsu LLM Wiki provider keys live in the desktop app (app-state.json), not here.
#
# Hermes interactive chat uses ~/.hermes/.env (OPENAI_API_KEY, GEMINI_API_KEY), NOT
# LLM_API_KEY below — run `hermes setup` or copy keys there. See runbook §10.2.
# =============================================================================

# *****************************************************
# Repo harness/scripts only (optional — not read by Hermes CLI)
# *****************************************************
# OpenAI-compatible API key for agents or scripts in this repo.
LLM_API_KEY=

# Base URL for LLM_API_KEY (OpenAI default shown).
LLM_BASE_URL=https://api.openai.com/v1

# Chat model id for Hermes or harness scripts.
LLM_MODEL=gpt-4o-mini

# *****************************************************
# Google Gemini (optional)
# *****************************************************
# API key for Gemini chat or image models.
GEMINI_API_KEY=

# Image generation or vision model id.
IMAGE_MODEL=

# Default Gemini chat model id.
GEMINI_MODEL=

# Embedding model id (vector search when scripts use Gemini embeddings).
EMBEDDING_MODEL=

# *****************************************************
# Nashsu local HTTP API (not an OpenAI key)
# *****************************************************
# Bearer token from LLM Wiki → Settings → API + MCP → Generate token.
# Used by curl, Hermes MCP env, and docs/harness/hermes-mcp.example.yaml.
LLM_WIKI_API_TOKEN=

# Optional override if the desktop API is not on 127.0.0.1:19828.
# LLM_WIKI_API_BASE_URL=http://127.0.0.1:19828/api/v1
